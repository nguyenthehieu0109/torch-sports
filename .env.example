# ===================================
# TORCH SPORTS - Environment Variables
# ===================================
# Copy file này thành .env và điền thông tin thực tế

# Database
DATABASE_URL="postgresql://torch_user:torch_password@localhost:5432/torch_sports_db"
MONGODB_URL="mongodb://admin:torch_password@localhost:27017/torch_sports?authSource=admin"
REDIS_URL="redis://localhost:6379"

# API
PORT=3000
API_PREFIX=api
NODE_ENV=development

# JWT
JWT_SECRET=torch_sports_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Mail (Gmail SMTP) — để trống SMTP_USER/SMTP_PASS thì mã OTP sẽ in ra console API
# SMTP_PASS là "App Password" 16 ký tự của Google (KHÔNG phải mật khẩu Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="TORCH SPORTS <your_email@gmail.com>"
