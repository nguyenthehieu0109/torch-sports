{
  "name": "torch-sports",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @torch/database generate",
    "db:migrate": "pnpm --filter @torch/database migrate:dev",
    "db:push": "pnpm --filter @torch/database db:push",
    "db:studio": "pnpm --filter @torch/database studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "sharp": "^0.35.5",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.8.1"
}
